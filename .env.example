# =============================================================================
# ClinRoute Environment Configuration Template
# =============================================================================
# Copy this file to .env and update with your actual values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# -----------------------------------------------------------------------------
# CLIENT CONFIGURATION
# -----------------------------------------------------------------------------
REACT_APP_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Using Supabase as the primary database (PostgreSQL)
# MongoDB is optional - uncomment if needed
# MONGODB_URI=mongodb://localhost:27017/clinroute

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# JWT Configuration - MUST CHANGE IN PRODUCTION!
# Generate a strong random key: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Get these from your Supabase project settings
# https://app.supabase.io/project/_/settings/api

# Backend Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Frontend Supabase Configuration (REACT_APP_ prefix)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# AI SERVICES CONFIGURATION
# -----------------------------------------------------------------------------
# Groq AI Configuration (for medical triage RAG)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
REACT_APP_GROQ_API_KEY=your-groq-api-key

# HuggingFace AI Configuration (optional)
# Get your API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Configure for production email notifications
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# FROM_EMAIL=noreply@clinroute.com
# FROM_NAME=ClinRoute

# -----------------------------------------------------------------------------
# OPTIONAL: FILE UPLOAD CONFIGURATION
# -----------------------------------------------------------------------------
# MAX_FILE_SIZE=10000000
# FILE_UPLOAD_PATH=./uploads

# -----------------------------------------------------------------------------
# OPTIONAL: RATE LIMITING
# -----------------------------------------------------------------------------
# RATE_LIMIT_WINDOW=15
# RATE_LIMIT_MAX=100
